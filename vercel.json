{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/push-dispatch?batch=100",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/notifications/exam-reminders?lead_minutes=120",
      "schedule": "*/10 * * * *"
    }
  ]
}
