# Copy this file to .env.local.
# This file is compiled into the Electron renderer. It may contain PUBLIC
# Supabase publishable/anon keys, but it must NEVER contain service-role/secret
# keys, Firebase private keys, AI API keys, admin passwords, or session secrets.

# Canonical deployed Next.js portal used by the snapshot API.
# Use http://localhost:3000 only for local development.
VITE_TV_APP_URL=https://your-kuet-cse-portal.example

# CMS project: landing-page and TV content.
NEXT_PUBLIC_CMS_SUPABASE_URL=https://your-cms-project.supabase.co
NEXT_PUBLIC_CMS_SUPABASE_ANON_KEY=your-cms-publishable-or-anon-key

# Academic project: routines and approved room bookings.
NEXT_PUBLIC_SUPABASE_URL=https://your-main-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-main-publishable-or-anon-key

# Display business timezone is fixed to Asia/Dhaka in snapshot schema v2.
