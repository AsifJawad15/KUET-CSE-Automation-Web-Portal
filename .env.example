# Public project identifiers (safe to send to browsers).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SESSION_SECRET=
# Project HS256 signing secret accepted by PostgREST; not the anon/service-role token.
SUPABASE_JWT_SECRET=

# Optional separate CMS project; omit all three to use the academic project.
NEXT_PUBLIC_CMS_SUPABASE_URL=
NEXT_PUBLIC_CMS_SUPABASE_ANON_KEY=
CMS_SUPABASE_SERVICE_ROLE_KEY=

# Optional FCM delivery. Private key uses literal \n between PEM lines.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
NOTIFICATION_DISPATCH_KEY=
CRON_SECRET=
